# TEMPLATE ONLY — variable names, never values.
#
# This file IS committed to the repository. Put real values in .env.local,
# which is gitignored. Anything you type here is public.
#
#   cp .env.example .env.local     # then fill .env.local in

# Base URL for canonical links, Open Graph tags, sitemap.xml and robots.txt.
# Must be the real deployed origin — no trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Contact form delivery (Resend) ----------------------------------------
# All three are required. With any of them missing, /api/contact returns 503
# and the form tells the visitor their message wasn't sent, rather than
# showing a false success.
#
# Next.js does NOT read this file at runtime. It loads .env.local — putting
# values here will not make the form work.
#
# These are server-only. Do NOT prefix any of them with NEXT_PUBLIC_ — that
# would ship the API key to every visitor's browser.

# From the Resend dashboard → API Keys. Starts with "re_".
RESEND_API_KEY=

# Where submissions are delivered — your own inbox. Any address works here.
CONTACT_TO_EMAIL=you@your-domain.com

# The sender. Must be on a domain verified in Resend → Domains, OR Resend's
# shared test sender `onboarding@resend.dev` — which only delivers to the
# address your Resend account is registered under.
#
# Needs the full "Name <address>" form, angle brackets included.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
